{
  "name": "buzz-gateway",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "exports": {
    "./eve": {
      "types": "./dist/integrations/eve/index.d.ts",
      "import": "./dist/integrations/eve/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "npm run typecheck && npm test",
    "build:adapter": "tsc -p tsconfig.adapter.json",
    "prepack": "npm run build:adapter",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "worker": "node daemon/main.ts"
  },
  "dependencies": {
    "@vercel/blob": "2.9.0",
    "@vercel/oidc": "4.0.9",
    "@vercel/queue": "0.11.0",
    "jose": "6.2.18",
    "nostr-tools": "2.26.1",
    "ws": "8.23.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "@vercel/config": "0.15.0",
    "eve": "1.0.0-rc.9",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "eve": "1.0.0-rc.9"
  },
  "peerDependenciesMeta": {
    "eve": {
      "optional": true
    }
  }
