# Set these on your Vercel project, then deploy.
BUZZ_GATEWAY_REGION=
BUZZ_GATEWAY_AGENTS=[]
BUZZ_GATEWAY_LOG_LEVEL=info

# When using a Vercel Connect API Key connector, set the SHA-256 hash of its callback key.
# BUZZ_GATEWAY_ACTION_KEY_SHA256=

# Set each agent's signing key as a Vercel Production Secret.
# BUZZ_EXAMPLE_SIGNING_KEY=

# Vercel sets BLOB_STORE_ID when you attach a private Blob store with OIDC.
